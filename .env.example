# GearLink 环境变量示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，切勿将真实密钥提交到仓库

# ---- DeepSeek / OpenAI 兼容服务 ----
# API 密钥（必填，可从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your-api-key-here

# 服务地址（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash
